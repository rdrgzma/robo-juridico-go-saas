  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LiquidacaoRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "principal": {
            "type": "string",
            "pattern": "^-?[0-9]{1,16}(\\.[0-9]{1,8})?$",
            "description": "Decimal em string, ponto, até 8 casas. Valores monetários de saída têm 2 casas."
          },
          "fator_correcao": {
            "type": "string",
            "pattern": "^-?[0-9]{1,16}(\\.[0-9]{1,8})?$",
            "description": "Decimal em string, ponto, até 8 casas. Valores monetários de saída têm 2 casas."
          },
          "taxa_mensal": {
            "type": "string",
            "pattern": "^-?[0-9]{1,16}(\\.[0-9]{1,8})?$",
            "description": "Decimal em string, ponto, até 8 casas. Valores monetários de saída têm 2 casas."
          },
          "meses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1200
          },
          "compostos": {
            "type": "boolean"
          },
          "pagamento": {
