# Referência: prefira scripts/dev.ps1 init ou scripts/dev.sh init para gerar .env.
# Preencha com segredos aleatórios independentes; nunca reutilize os do legado.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
TEST_DB_PASSWORD=
# SHA-256 da chave aleatória em .dev-api-key; o token não entra na imagem.
API_KEY_SHA256=
# Chave AES-256 para MFA/outbox e assinatura de CSRF. Não regenerar em banco existente.
AUTH_ENCRYPTION_KEY=
# Compose fixa APP_ENV=development e HTTP_ADDR=0.0.0.0:8080 no contêiner.
# Host autorizado: 127.0.0.1:8081 (8080 permanece com o legado).
# DATABASE_URL e TEST_DATABASE_URL são montadas pelo Compose com hostname db.
# Produção exige configuração segregada e homologação da segurança das próximas sprints.

# Fontes opcionais do painel; segredos ficam somente no .env local.
DATAJUD_API_KEY=
DJEN_ENABLED=false
